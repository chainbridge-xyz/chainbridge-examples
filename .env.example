# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# === RPC ===
# Free key from https://www.alchemy.com (or Infura, or any Base Sepolia RPC).
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# === Test wallet ===
# Generate a fresh one — DO NOT use a wallet that holds real funds.
#   npx tsx -e "import {privateKeyToAccount, generatePrivateKey} from 'viem/accounts'; const k=generatePrivateKey(); console.log('PRIVATE_KEY=', k); console.log('ADDRESS=', privateKeyToAccount(k).address);"
# Fund it with Base Sepolia ETH (https://www.alchemy.com/faucets/base-sepolia)
# and test USDC (https://faucet.circle.com).
PRIVATE_KEY=0x_YOUR_TEST_PRIVATE_KEY_HERE

# === Pimlico (ERC-4337 bundler + paymaster) ===
# Only needed by the consumer, and only for `--provision`.
# Free tier: https://dashboard.pimlico.io
PIMLICO_API_KEY=YOUR_PIMLICO_KEY_HERE

# === Where the seller receives USDC ===
# Leave unset and the seller pays into its own submitter address.
# Set it to your smart account address to watch USDC move EOA -> smart account.
# X402_RECIPIENT=0x_YOUR_SMART_ACCOUNT_ADDRESS_HERE
